# Credenciais do Supabase (nuvem + login).
# Copie este arquivo para ".env" (mesma pasta) e preencha com os seus valores.
# Você encontra estes valores no painel do Supabase em:
#   Project Settings > API
#
# Sem estes valores, o sistema continua funcionando 100% local (sem login).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL pública do sistema (usada nos links compartilhados da Agenda)
VITE_APP_URL=https://campanha.space

# Google Maps (mapas embutidos: Visitas, Montar Rotas, Mapa Eleitoral)
# Crie em Google Cloud Console > APIs & Services > Credentials
# Ative "Maps JavaScript API" e restrinja a chave ao seu domínio.

# Geocodificação de endereços (opcional — sem chave usa Nominatim/OSM)
# Google: ative "Geocoding API" na mesma chave ou outra restrita ao domínio
VITE_GOOGLE_GEOCODING_API_KEY=
# Mapbox: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=
# LocationIQ: https://locationiq.com/
VITE_LOCATIONIQ_API_KEY=
# CARTO basemaps (opcional — sem chave o app usa tiles OpenStreetMap)
# Chave gratuita: https://carto.com/basemaps/apikey/
VITE_CARTO_API_KEY=

# API PHP do Hostinger para dados TSE (substituiu a Netlify Function)
VITE_HOSTINGER_API_URL=https://campanha.space/api/tse.php
HOSTINGER_IMPORT_URL=https://campanha.space/api/import.php

# Hostinger MySQL (apenas para scripts locais, opcional)
HOSTINGER_DB_HOST=srv1437.hstgr.io
HOSTINGER_DB_USER=u176739135_hospedagem
HOSTINGER_DB_PASSWORD=sua-senha
HOSTINGER_DB_NAME=u176739135_campanha
